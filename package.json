{
  "name": "theme-view-studio",
  "version": "1.3.2",
  "description": "Folder-scoped appearance presets for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint -c eslint.review.mjs src"
  },
  "keywords": [
    "obsidian",
    "theme",
    "appearance"
  ],
  "author": "rosswang",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0"
  }
}
